#!/usr/bin/env sh

set -eu

echo "[gitleaks] Pre-commit secret scan"

REPO_ROOT="$(git rev-parse --show-toplevel)"
GIT_DIR="$(git rev-parse --git-dir)"

cd "$REPO_ROOT"

ENABLED="$(git config --bool --get gitleaks.enabled 2>/dev/null || echo true)"

if [ "$ENABLED" != "true" ]; then
    echo "[gitleaks] Disabled via git config."
    exit 0
fi

if git diff --cached --quiet; then
    echo "[gitleaks] Nothing staged. Skipping scan."
    exit 0
fi

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        LOCAL_GITLEAKS="${GIT_DIR}/tools/gitleaks.exe"
        ;;
    *)
        LOCAL_GITLEAKS="${GIT_DIR}/tools/gitleaks"
        ;;
esac

if [ -f "$LOCAL_GITLEAKS" ]; then
    GITLEAKS_BIN="$LOCAL_GITLEAKS"
elif command -v gitleaks >/dev/null 2>&1; then
    GITLEAKS_BIN="$(command -v gitleaks)"
else
    echo "[gitleaks] Gitleaks not found."
    echo "[gitleaks] Installing automatically..."

    INSTALLER_URL="$(
        git config --get gitleaks.installerUrl 2>/dev/null ||
        echo "https://raw.githubusercontent.com/visys-dev/gitleaks-precommit-hook/main/scripts/install-gitleaks.sh"
    )"

    if ! curl \
        --fail \
        --silent \
        --show-error \
        --location \
        "$INSTALLER_URL" |
        sh
    then
        echo "[gitleaks] ERROR: automatic Gitleaks installation failed." >&2
        exit 2
    fi

    if [ ! -f "$LOCAL_GITLEAKS" ]; then
        echo "[gitleaks] ERROR: Gitleaks binary was not created." >&2
        exit 2
    fi

    GITLEAKS_BIN="$LOCAL_GITLEAKS"
fi

echo "[gitleaks] Using: $GITLEAKS_BIN"

if "$GITLEAKS_BIN" git \
    --staged \
    --redact \
    --verbose
then
    echo "[gitleaks] No secrets detected."
    exit 0
else
    STATUS=$?
fi

echo >&2
echo "==========================================" >&2
echo "ERROR: Gitleaks detected a potential secret." >&2
echo "Commit rejected." >&2
echo "Remove the secret and stage the changes again." >&2
echo "==========================================" >&2

exit "$STATUS"
